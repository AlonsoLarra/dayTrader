# Exchange: bitso (default), binance, or paper
EXCHANGE=bitso
# Set PAPER_MODE=true to simulate trades using real Bitso prices (recommended to start)
PAPER_MODE=true

# Bitso API — get yours at https://bitso.com/api_info
BITSO_API_KEY=your_bitso_api_key
BITSO_API_SECRET=your_bitso_api_secret

# Binance API (not available in the US)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Trading settings (amounts in MXN when using Bitso)
TRADING_PAIR=BTC/MXN
INITIAL_BUDGET=10000.0
STOP_LOSS_PCT=0.03
MAX_TRADES_PER_DAY=10

# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./daytrader.db
# Railway PostgreSQL (set this in Railway's environment variables panel):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/daytrader

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production (add your Vercel URL):
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ─── API Security (optional but recommended for production) ──────────────────
# If set, all /api requests require: Authorization: Bearer <this_value>
# Generate a strong random string: openssl rand -hex 32
API_SECRET_KEY=
