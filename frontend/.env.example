# ─── API URL ──────────────────────────────────────────────────────────────────
# Leave empty when running locally (Vite proxy forwards /api to localhost:8000)
VITE_API_BASE_URL=

# Production (Railway backend):
# VITE_API_BASE_URL=https://your-backend.railway.app/api

# ─── WebSocket URL ────────────────────────────────────────────────────────────
# Leave empty when running locally
VITE_WS_URL=

# Production (Railway backend — note wss:// not ws://):
# VITE_WS_URL=wss://your-backend.railway.app/ws

# ─── API Security (must match API_SECRET_KEY in backend .env) ────────────────
# Only set if you configured API_SECRET_KEY in the backend
VITE_API_SECRET_KEY=
